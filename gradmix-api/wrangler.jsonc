{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gradmix-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "BUNDLES", "class_name": "BundleDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject", "BundleDurableObject"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "gradmix-audio"
    }
  ],
  "routes": [
    {
      "pattern": "api.gradmix.arc03.online",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://gradmix.arc03.online,https://gradmix.vercel.app,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173"
  }
}
